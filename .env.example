# Conexión de la demo a PostgreSQL y dirección desde la que se abre Pulso.
DATABASE_URL=postgresql://pulso:pulso-dev-local@127.0.0.1:5432/pulso
APP_URL=http://localhost:3000

# Acceso real. Autoriza la ruta /api/auth/callback en la configuración de redirecciones de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo opcional. Si la activas en producción, configura un secreto largo y aleatorio.
# DEMO_MODE=true
# DEMO_SESSION_SECRET=

# El modo development registra correos simulados en la base de datos. Para enviar correos reales, usa resend.
MAIL_MODE=development
MAIL_FROM=
RESEND_API_KEY=
# El programador usa este secreto al llamar a /api/cron.
CRON_SECRET=
